@model IReadOnlyList<ParmeniaHub.Application.Entregables.EntregableDto>
@{ ViewData["Title"] = "Entregables"; }
<div class="card"><div class="card-header d-flex justify-content-between"><div><h4>Seguimiento de entregables</h4><p class="text-muted mb-0">Función stateful: el estado y los comentarios quedan guardados.</p></div><a asp-action="Crear" class="btn btn-primary">+ Nuevo entregable</a></div><div class="card-body">
@if (Model.Count == 0) { <div class="alert alert-info">No hay entregables registrados.</div> }
@foreach (var item in Model) { <div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between"><div><h5>@item.Nombre</h5><p>@item.Descripcion</p></div><span class="badge bg-primary-subtle text-primary h-25">@item.Estado</span></div>
<form asp-action="CambiarEstado" method="post" class="row g-2"><input type="hidden" name="id" value="@item.Id"/><div class="col-md-3"><select name="estado" asp-items="Html.GetEnumSelectList<ParmeniaHub.Domain.Entregables.EstadoEntregable>()" class="form-select"></select></div><div class="col-md-6"><input name="comentarios" class="form-control" placeholder="Comentario de la revisión" value="@item.Comentarios"/></div><div class="col-md-3"><button class="btn btn-outline-primary w-100" @(item.Estado == ParmeniaHub.Domain.Entregables.EstadoEntregable.Aprobado ? "disabled" : null)>Actualizar</button></div></form>
<details class="mt-3"><summary>Ver historial (@item.Revisiones.Count)</summary><ul class="mt-2 mb-0">@foreach (var revision in item.Revisiones) { <li><strong>@revision.Estado</strong> — @revision.Fecha.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm") — @revision.Comentarios</li> }</ul></details></div> }
</div></div>
