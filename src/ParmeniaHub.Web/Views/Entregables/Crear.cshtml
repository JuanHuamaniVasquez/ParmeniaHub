@model ParmeniaHub.Web.ViewModels.Entregables.CrearEntregableViewModel
@{ ViewData["Title"] = "Nuevo entregable"; }
<div class="row justify-content-center"><div class="col-lg-8"><div class="card"><div class="card-header"><h4>Nuevo entregable</h4></div><div class="card-body"><form asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="PostulacionId" class="form-label"></label><select asp-for="PostulacionId" asp-items="ViewBag.Postulaciones" class="form-select"><option value="">Selecciona un proyecto</option></select></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/></div><div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control"></textarea></div>
<button class="btn btn-primary">Crear</button> <a asp-action="Index" class="btn btn-light">Cancelar</a></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
