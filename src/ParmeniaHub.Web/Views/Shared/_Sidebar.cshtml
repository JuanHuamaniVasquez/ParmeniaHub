@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var convocatoriasActive = controller == "Convocatorias" ? "active" : string.Empty;
    var inicioActive = controller == "Home" ? "active" : string.Empty;
}

<aside class="sidebar sidebar-default sidebar-white sidebar-base navs-rounded-all">
    <div class="sidebar-header d-flex align-items-center justify-content-start">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand">
            <span class="parmenia-logo">P</span>
            <h4 class="logo-title mb-0">Parmenia Hub</h4>
        </a>
        <div class="sidebar-toggle" data-toggle="sidebar" data-active="true">
            <i class="icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M4.25 12.27H19.25M10.3 18.3L4.25 12.27L10.3 6.25"
                          stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </i>
        </div>
    </div>

    <div class="sidebar-body pt-0 data-scrollbar">
        <div class="sidebar-list">
            <ul class="navbar-nav iq-main-menu" id="sidebar-menu">
                <li class="nav-item static-item">
                    <span class="nav-link static-item disabled">
                        <span class="default-icon">Gestión</span>
                        <span class="mini-icon">–</span>
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link @inicioActive" asp-controller="Home" asp-action="Index">
                        <i class="icon">
                            <svg class="icon-20" width="20" viewBox="0 0 24 24" fill="none">
                                <path opacity=".4" d="M4 10.5V19a2 2 0 0 0 2 2h3v-6h6v6h3a2 2 0 0 0 2-2v-8.5" fill="currentColor"></path>
                                <path d="M2.8 11.2 11 3.5a1.5 1.5 0 0 1 2 0l8.2 7.7a1 1 0 0 1-1.4 1.5L12 5.4l-7.8 7.3a1 1 0 1 1-1.4-1.5Z" fill="currentColor"></path>
                            </svg>
                        </i>
                        <span class="item-name">Inicio</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @convocatoriasActive" asp-controller="Convocatorias" asp-action="Index">
                        <i class="icon">
                            <svg class="icon-20" width="20" viewBox="0 0 24 24" fill="none">
                                <path opacity=".4" d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="currentColor"></path>
                                <path d="M7 8h10v2H7V8Zm0 4h10v2H7v-2Zm0 4h6v2H7v-2Z" fill="currentColor"></path>
                            </svg>
                        </i>
                        <span class="item-name">Convocatorias</span>
                    </a>
                </li>

                <li><hr class="hr-horizontal" /></li>
                <li class="nav-item static-item">
                    <span class="nav-link static-item disabled">
                        <span class="default-icon">Próximos módulos</span>
                        <span class="mini-icon">–</span>
                    </span>
                </li>
                @foreach (var item in new[] { "Equipos", "Proyectos", "Entregables", "Anuncios" })
                {
                    <li class="nav-item">
                        <span class="nav-link disabled parmenia-disabled-link">
                            <i class="icon">
                                <svg class="icon-20" width="20" viewBox="0 0 24 24" fill="none">
                                    <circle cx="12" cy="12" r="9" opacity=".25" fill="currentColor"></circle>
                                    <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
                                </svg>
                            </i>
                            <span class="item-name">@item</span>
                            <span class="badge bg-primary-subtle text-primary ms-auto item-name">Pronto</span>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="sidebar-footer"></div>
</aside>
