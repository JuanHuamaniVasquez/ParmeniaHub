<!doctype html>
<html lang="es" dir="ltr" data-bs-theme="light" data-bs-theme-color="theme-color-default">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] | Parmenia Hub</title>
    <link rel="shortcut icon" href="~/hope-ui/images/favicon.ico" />
    <link rel="stylesheet" href="~/hope-ui/css/core/libs.min.css" />
    <link rel="stylesheet" href="~/hope-ui/vendor/aos/dist/aos.css" />
    <link rel="stylesheet" href="~/hope-ui/css/hope-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hope-ui/css/custom.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hope-ui/css/customizer.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/parmenia.css" asp-append-version="true" />
</head>
<body>
    <div id="loading">
        <div class="loader simple-loader">
            <div class="loader-body"></div>
        </div>
    </div>

    <partial name="_Sidebar" />

    <main class="main-content">
        <div class="position-relative iq-banner">
            <partial name="_Navbar" />

            <div class="iq-navbar-header parmenia-header">
                <div class="container-fluid iq-container">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex flex-wrap justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-white text-primary mb-2">Incubadora universitaria</span>
                                    <h1 class="text-white mb-2">@ViewData["Title"]</h1>
                                    <p class="text-white-50 mb-0">
                                        Gestiona las oportunidades, proyectos y procesos de Parmenia.
                                    </p>
                                </div>
                                <div class="parmenia-header-mark" aria-hidden="true">P</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="iq-header-img">
                    <img src="~/hope-ui/images/dashboard/top-header.png"
                         alt=""
                         class="img-fluid w-100 h-100 animated-scaleX" />
                </div>
            </div>
        </div>

        <div class="container-fluid content-inner mt-n5 py-0">
            @RenderBody()
        </div>

        <partial name="_Footer" />
    </main>

    <script src="~/hope-ui/js/core/libs.min.js"></script>
    <script src="~/hope-ui/js/core/external.min.js"></script>
    <script src="~/hope-ui/vendor/aos/dist/aos.js"></script>
    <script src="~/hope-ui/js/hope-ui.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
