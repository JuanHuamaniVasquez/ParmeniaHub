@model ParmeniaHub.Application.Convocatorias.ConvocatoriaDto
@using ParmeniaHub.Domain.Convocatorias

@{
    ViewData["Title"] = Model.Titulo;
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4" data-aos="fade-up" data-aos-delay="100">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <h3 class="mb-0">@Model.Titulo</h3>
                <span class="badge bg-primary-subtle text-primary">@Model.Estado</span>
            </div>
            <p class="text-muted mb-0">Programa de @Model.TipoPrograma</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            @if (Model.Estado == EstadoConvocatoria.Borrador)
            {
                <form asp-action="Publicar" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">Publicar</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4" data-aos="fade-up" data-aos-delay="150">
            <div class="card-body">
                <h2 class="h5">Descripción</h2>
                <p class="mb-0" style="white-space: pre-line">@Model.Descripcion</p>
            </div>
        </div>
        <div class="card" data-aos="fade-up" data-aos-delay="200">
            <div class="card-body">
                <h2 class="h5">Requisitos</h2>
                <p class="mb-0" style="white-space: pre-line">@Model.Requisitos</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card" data-aos="fade-up" data-aos-delay="250">
            <div class="card-body">
                <h2 class="h5">Fechas</h2>
                <dl class="mb-0">
                    <dt>Inscripciones</dt>
                    <dd>
                        @Model.InicioInscripciones.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")<br />
                        al @Model.FinInscripciones.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")
                    </dd>
                    <dt>Programa</dt>
                    <dd class="mb-0">
                        @Model.InicioPrograma.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")<br />
                        al @Model.FinPrograma.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
