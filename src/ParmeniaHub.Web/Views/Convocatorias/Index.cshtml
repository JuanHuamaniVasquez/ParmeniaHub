@model IReadOnlyList<ParmeniaHub.Application.Convocatorias.ConvocatoriaDto>

@{
    ViewData["Title"] = "Convocatorias";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card" data-aos="fade-up" data-aos-delay="100">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="header-title">
                    <h4 class="card-title mb-1">Convocatorias registradas</h4>
                    <p class="text-muted mb-0">Programas de preincubación e incubación.</p>
                </div>
                <a asp-action="Crear" class="btn btn-primary">
                    <span class="me-1">+</span> Nueva convocatoria
                </a>
            </div>
            <div class="card-body px-0">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info mx-4 mb-0">
                    Todavía no se han registrado convocatorias.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 parmenia-table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Programa</th>
                    <th>Inscripciones</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var convocatoria in Model)
                {
                    <tr>
                        <td>@convocatoria.Titulo</td>
                        <td>@convocatoria.TipoPrograma</td>
                        <td>
                            @convocatoria.InicioInscripciones.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy")
                            –
                            @convocatoria.FinInscripciones.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary">@convocatoria.Estado</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalle"
                               asp-route-id="@convocatoria.Id"
                               class="btn btn-sm btn-outline-primary">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
                    </table>
                </div>
            }
            </div>
        </div>
    </div>
</div>
